{
  "seedVersion": 1,
  "router": {
    "name": "SMS Default Routing",
    "description": null,
    "fallback_provider": "openrouter",
    "fallback_model": "z-ai/glm-5.3-flash",
    "cooldown_seconds": 300
  },
  "rules": [
    {
      "enabled": 1,
      "priority": 1,
      "type": "calculated",
      "title": "confidentiality_keep_local",
      "description": null,
      "condition_logic": "AND",
      "conditions": [
        {
          "property": "promptContent",
          "comparator": "contains",
          "value": "confidential, private, secret"
        }
      ],
      "route_provider": "anythingllm_ollama",
      "route_model": "qwen3-vl:4b-instruct"
    },
    {
      "enabled": 1,
      "priority": 2,
      "type": "calculated",
      "title": "coding",
      "description": null,
      "condition_logic": "AND",
      "conditions": [
        {
          "property": "promptContent",
          "comparator": "contains",
          "value": "code"
        }
      ],
      "route_provider": "openrouter",
      "route_model": "qwen/qwen3-coder-flash"
    }
  ],
  "envDefaults": {
    "LLM_PROVIDER": "openrouter",
    "GENERIC_OPEN_AI_BASE_PATH": "https://openrouter.ai/api/v1",
    "GENERIC_OPEN_AI_MODEL_PREF": "z-ai/glm-5.3-flash",
    "GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT": 8192,
    "GENERIC_OPEN_AI_MAX_TOKENS": 1024,
    "OPENROUTER_MODEL_PREF": "z-ai/glm-5.3-flash",
    "OPENROUTER_TIMEOUT_MS": "3000",
    "OPENROUTER_SERVICE_TIER": "default",
    "EMBEDDING_ENGINE": "native",
    "VECTOR_DB": "lancedb"
  },
  "keyInjection": {
    "sourceFileKey": "openrouter",
    "envVar": "OPENROUTER_API_KEY",
    "requiredEnvDefaults": [
      "LLM_PROVIDER",
      "GENERIC_OPEN_AI_BASE_PATH"
    ]
  },
  "settings": [
    {
      "key": "onboarding_complete",
      "value": "true"
    },
    {
      "key": "_seeded_by_sms_toolkit",
      "value": "v2"
    }
  ]
}
